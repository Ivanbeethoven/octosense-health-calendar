let entries = {}
let view_year = 2026
let view_month = 10
let selected_date = ""
let selected_year = 2026
let selected_month = 10
let selected_day = 1
let today_key = ""
let tab = "food"
let cur = {}
let week_labels = ["日" "一" "二" "三" "四" "五" "六"]

// 可配置的选项表：默认值见下，用户可以在“设置”里增删，保存在本机 settings.json
let opt_food = ["粥类" "米面主食" "肉类" "青菜" "蛋奶" "水果" "汤羹" "饮品" "甜点"]
let opt_cuisine = ["家常" "川菜" "粤菜" "江浙" "西北" "日韩" "西式" "外卖"]
let opt_equip = ["哑铃" "杠铃" "壶铃" "跑步机" "动感单车" "划船机" "椭圆机" "瑜伽垫" "弹力带" "徒手"]
let opt_supp = ["维生素C" "维生素B族" "维生素D" "鱼油" "钙片" "益生菌" "蛋白粉" "镁" "锌" "铁" "褪黑素"]

// AI：默认走火山方舟 Responses API；Key 由本地脚本导入隔离存储
let ai_url = "https://ark.cn-beijing.volces.com/api/plan/v3/responses"
let ai_model = "ark-code-latest"
let ai_token = ""
let ai_busy = false

fn pad2(n){
    if n < 10 { return "0" + n }
    return "" + n
}

fn date_key(y, m, d){
    return "" + y + "-" + pad2(m) + "-" + pad2(d)
}

fn is_leap(y){
    if y % 4 != 0 { return false }
    if y % 100 != 0 { return true }
    return y % 400 == 0
}

fn days_in_month(y, m){
    if m == 2 {
        if is_leap(y) { return 29 }
        return 28
    }
    if m == 4 || m == 6 || m == 9 || m == 11 { return 30 }
    return 31
}

fn weekday_of(y, m, d){
    let yy = y
    if m < 3 { yy = yy - 1 }
    let table = [0 3 2 5 0 3 5 1 4 6 2 4]
    return (yy + floor(yy / 4) - floor(yy / 100) + floor(yy / 400) + table[m - 1] + d) % 7
}

fn empty_record(){
    return {
        food: "" food_cats: {} cuisines: {} photos: []
        fit_eq: {} fit_sets: "" fit_reps: "" fit_weight: "" fit_min: "" fit_note: ""
        supps: {} supp_note: ""
        mood: "" body: "" sleep: "" note: "" ai: ""
    }
}

fn field_str(r, k){
    let v = try { r[k] } catch { nil }
    if v == nil { return "" }
    return "" + v
}

fn field_list(r, k){
    let v = try { r[k] } catch { nil }
    if v == nil { return [] }
    return v
}

fn field_obj(r, k){
    let v = try { r[k] } catch { nil }
    if v == nil { return {} }
    return v
}

fn safe_record(k){
    let out = empty_record()
    let r = try { entries[k] } catch { nil }
    if r == nil { return out }
    out.food = field_str(r, "food")
    out.food_cats = field_obj(r, "food_cats")
    out.cuisines = field_obj(r, "cuisines")
    out.photos = field_list(r, "photos")
    out.fit_eq = field_obj(r, "fit_eq")
    out.fit_sets = field_str(r, "fit_sets")
    out.fit_reps = field_str(r, "fit_reps")
    out.fit_weight = field_str(r, "fit_weight")
    out.fit_min = field_str(r, "fit_min")
    out.fit_note = field_str(r, "fit_note")
    out.supps = field_obj(r, "supps")
    out.supp_note = field_str(r, "supp_note")
    out.mood = field_str(r, "mood")
    out.body = field_str(r, "body")
    out.sleep = field_str(r, "sleep")
    out.note = field_str(r, "note")
    out.ai = field_str(r, "ai")
    return out
}

fn list_has(a, item){
    for v in a {
        if v == item { return true }
    }
    return false
}

fn list_remove(a, item){
    let out = []
    for v in a {
        if v != item { out.push(v) }
    }
    return out
}

fn list_add(a, item){
    let v = item.trim()
    if v == "" { return a }
    if list_has(a, v) { return a }
    a.push(v)
    return a
}

fn set_has(o){
    if o == nil { return false }
    for key v in o {
        if v == true { return true }
    }
    return false
}

fn on_in(r, k, item){
    let o = field_obj(r, k)
    let v = try { o[item] } catch { false }
    return v == true
}

fn names_in(r, k){
    let o = field_obj(r, k)
    let s = ""
    for key v in o {
        if v == true {
            if s == "" { s = key } else { s = s + "、" + key }
        }
    }
    if s == "" { return "未选择" }
    return s
}

fn record_has_data(r){
    if r == nil { return false }
    if r.food != "" { return true }
    if r.fit_sets != "" || r.fit_reps != "" || r.fit_weight != "" || r.fit_min != "" || r.fit_note != "" { return true }
    if r.supp_note != "" { return true }
    if r.mood != "" || r.body != "" || r.sleep != "" || r.note != "" { return true }
    if r.photos.len() > 0 { return true }
    if set_has(r.food_cats) || set_has(r.cuisines) || set_has(r.fit_eq) || set_has(r.supps) { return true }
    return false
}

fn has_entry(k){
    return record_has_data(safe_record(k))
}

fn mark(k){
    if has_entry(k) { return "•" }
    return " "
}

fn logged_count(){
    let n = 0
    for key v in entries {
        if record_has_data(safe_record(key)) { n = n + 1 }
    }
    return n
}

fn month_count(y, m){
    let n = 0
    let total = days_in_month(y, m)
    for i in total {
        if has_entry(date_key(y, m, i + 1)) { n = n + 1 }
    }
    return n
}

fn streak_days(){
    let t = local_time()
    let y = t.year
    let m = t.month
    let d = t.day
    let n = 0
    let guard = 0
    while guard < 370 {
        if !has_entry(date_key(y, m, d)) { break }
        n = n + 1
        if d > 1 {
            d = d - 1
        } else if m > 1 {
            m = m - 1
            d = days_in_month(y, m)
        } else {
            y = y - 1
            m = 12
            d = 31
        }
        guard = guard + 1
    }
    return n
}

fn load_store(){
    if fs.exists("health_calendar.json") {
        let v = fs.read("health_calendar.json").parse_json()
        if v != nil { entries = v }
    }
}

fn save_store(){
    fs.write("health_calendar.json", entries.to_json())
}

fn load_settings(){
    if !fs.exists("settings.json") { return }
    let v = fs.read("settings.json").parse_json()
    if v == nil { return }
    let f = try { v.food_cats } catch { nil }
    if f != nil { opt_food = f }
    let c = try { v.cuisines } catch { nil }
    if c != nil { opt_cuisine = c }
    let e = try { v.equip } catch { nil }
    if e != nil { opt_equip = e }
    let s = try { v.supps } catch { nil }
    if s != nil { opt_supp = s }
    ai_token = field_str(v, "ai_token")
    let m = field_str(v, "ai_model")
    if m != "" { ai_model = m }
}

fn save_settings(){
    let o = {
        food_cats: opt_food cuisines: opt_cuisine equip: opt_equip supps: opt_supp
        ai_token: ai_token ai_model: ai_model
    }
    fs.write("settings.json", o.to_json())
}

fn month_title(){
    return "" + view_year + "年" + view_month + "月"
}

fn detail_title(){
    let s = "" + selected_month + "月" + selected_day + "日 周" + week_labels[weekday_of(selected_year, selected_month, selected_day)]
    if selected_date == today_key { s = s + " · 今天" }
    return s
}

fn render_month(){
    ui.month_label.set_text(month_title())
    ui.stat_month.set_text("" + month_count(view_year, view_month))
    ui.stat_streak.set_text("" + streak_days())
    ui.stat_total.set_text("" + logged_count())
    ui.calendar.render()
}

fn mark_saved(){
    ui.save_status.set_text("已保存到本机")
}

fn begin_edit(){
    cur = safe_record(selected_date)
}

fn save_current(){
    if selected_date == "" { return }
    cur.food = ("" + ui.food_input.text()).trim()
    cur.fit_sets = ("" + ui.fit_sets.text()).trim()
    cur.fit_reps = ("" + ui.fit_reps.text()).trim()
    cur.fit_weight = ("" + ui.fit_weight.text()).trim()
    cur.fit_min = ("" + ui.fit_min.text()).trim()
    cur.fit_note = ("" + ui.fit_note.text()).trim()
    cur.supp_note = ("" + ui.supp_note.text()).trim()
    cur.mood = ("" + ui.mood_input.text()).trim()
    cur.body = ("" + ui.body_input.text()).trim()
    cur.sleep = ("" + ui.sleep_input.text()).trim()
    cur.note = ("" + ui.note_input.text()).trim()
    entries[selected_date] = cur
    save_store()
}

fn save_and_refresh(){
    save_current()
    mark_saved()
    render_month()
}

fn toggle_in(group, item){
    if selected_date == "" { return }
    let o = field_obj(cur, group)
    let on = try { o[item] } catch { false }
    o[item] = !(on == true)
    cur[group] = o
    entries[selected_date] = cur
    save_store()
}

fn toggle_food_cat(c){
    toggle_in("food_cats", c)
    ui.cats_row.render()
    render_month()
    mark_saved()
}

fn toggle_cuisine(c){
    toggle_in("cuisines", c)
    ui.cuisine_row.render()
    render_month()
    mark_saved()
}

fn toggle_equip(c){
    toggle_in("fit_eq", c)
    ui.equip_row.render()
    render_month()
    mark_saved()
}

fn toggle_supp(c){
    toggle_in("supps", c)
    ui.supp_row.render()
    render_month()
    mark_saved()
}

fn refresh_photos(){
    let ps = field_list(cur, "photos")
    if ps.len() == 0 {
        ui.thumb_box.set_visible(false)
        ui.photo_count.set_text("还没有照片")
        return
    }
    ui.photo_count.set_text("已保存 " + ps.len() + " 张照片")
    let last = ps[ps.len() - 1]
    if last.split(".jpg").len() > 1 {
        ui.thumb.load_image_from_data_async(fs.read_bytes(last))
    }
    ui.thumb_box.set_visible(true)
}

fn open_camera(){
    ui.cam_note.set_text("正在启动相机…")
    ui.cam_overlay.set_visible(true)
    ui.cam.start()
}

fn close_camera(){
    ui.cam.stop()
    ui.cam_overlay.set_visible(false)
}

fn camera_failed(){
    ui.cam_note.set_text("相机在这台设备上不可用：" + ui.cam.error())
}

fn photo_captured(){
    let shot = ui.cam.last()
    if shot == "" { return }
    let ps = field_list(cur, "photos")
    ps.push(shot)
    cur.photos = ps
    entries[selected_date] = cur
    save_store()
    close_camera()
    refresh_photos()
    render_month()
    mark_saved()
}

fn delete_last_photo(){
    let ps = field_list(cur, "photos")
    if ps.len() == 0 { return }
    let last = ps[ps.len() - 1]
    ps.remove(ps.len() - 1)
    if fs.exists(last) { fs.remove(last) }
    cur.photos = ps
    entries[selected_date] = cur
    save_store()
    refresh_photos()
    render_month()
    mark_saved()
}

fn open_photo_viewer(){
    let ps = field_list(cur, "photos")
    if ps.len() == 0 { return }
    let last = ps[ps.len() - 1]
    if last.split(".jpg").len() > 1 {
        ui.full.load_image_from_data_async(fs.read_bytes(last))
        ui.viewer_note.set_text("")
    } else {
        ui.viewer_note.set_text("这个文件无法预览")
    }
    ui.viewer.set_visible(true)
}

fn show_tab(name){
    tab = name
    ui.pane_food.set_visible(name == "food")
    ui.pane_fit.set_visible(name == "fit")
    ui.pane_supp.set_visible(name == "supp")
    ui.pane_body.set_visible(name == "body")
    ui.tabbar.render()
}

fn load_day(){
    begin_edit()
    ui.detail_title.set_text(detail_title())
    ui.food_input.set_text(cur.food)
    ui.fit_sets.set_text(cur.fit_sets)
    ui.fit_reps.set_text(cur.fit_reps)
    ui.fit_weight.set_text(cur.fit_weight)
    ui.fit_min.set_text(cur.fit_min)
    ui.fit_note.set_text(cur.fit_note)
    ui.supp_note.set_text(cur.supp_note)
    ui.mood_input.set_text(cur.mood)
    ui.body_input.set_text(cur.body)
    ui.sleep_input.set_text(cur.sleep)
    ui.note_input.set_text(cur.note)
    if cur.ai == "" { ui.ai_answer.set_text("还没有生成分析。") }
    else { ui.ai_answer.set_text(cur.ai) }
    ui.ai_status.set_text("只用你主动点击“生成分析”的那一天：记录文字会发给你自己配置的 AI，照片不会发送。仅供参考，不构成医疗诊断。")
    ui.save_status.set_text("")
    ui.tabbar.render()
    ui.cats_row.render()
    ui.cuisine_row.render()
    ui.equip_row.render()
    ui.supp_row.render()
    refresh_photos()
}

fn select_day(y, m, d){
    if selected_date != "" { save_current() }
    selected_year = y
    selected_month = m
    selected_day = d
    selected_date = date_key(y, m, d)
    load_day()
    render_month()
}

fn shift_month(delta){
    save_current()
    if delta < 0 {
        view_month = view_month - 1
        if view_month < 1 { view_month = 12; view_year = view_year - 1 }
    } else {
        view_month = view_month + 1
        if view_month > 12 { view_month = 1; view_year = view_year + 1 }
    }
    let t = local_time()
    let d = 1
    if view_year == t.year && view_month == t.month { d = t.day }
    select_day(view_year, view_month, d)
    render_month()
}

fn go_today(){
    let t = local_time()
    view_year = t.year
    view_month = t.month
    select_day(t.year, t.month, t.day)
    render_month()
}

fn clear_current(){
    if selected_date == "" { return }
    entries[selected_date] = empty_record()
    save_store()
    load_day()
    render_month()
    ui.save_status.set_text("已清空当天")
}

