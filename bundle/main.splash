                Label{text: "保健品 / 补剂" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                Hint{text: "点选项即删除；例如加上“辅酶Q10”“胶原蛋白”。"}
                set_supp_row := ScrollXView{width: Fill height: 38 flow: Right spacing: 6
                    on_render: || {
                        if opt_supp.len() == 0 { Label{text: "（暂无选项）" draw_text.color: secondary draw_text.text_style.font_size: 12} }
                        for c in opt_supp { ChipDel{text: c + " ×" on_click: || del_supp(c)} }
                    }
                }
                View{width: Fill height: Fit flow: Right spacing: 8
                    View{width: Fill height: Fit flow: Down
                        new_supp := Input{empty_text: "新增补剂，例如：辅酶Q10"}
                    }
                    Chip{text: "添加" on_click: || add_supp()}
                }
            }

            Card{
                Label{text: "AI 接口" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                Hint{text: "连接火山方舟；凭据由本机配置提供。"}
                ai_config_status := Label{text: "" draw_text.color: accent draw_text.text_style.font_size: 12}
                Hint{text: "模型名"}
                set_model := Input{empty_text: "ark-code-latest"}
                Primary{width: Fill text: "保存模型设置" on_click: || save_ai_settings()}
                Label{text: "只有点击生成分析时，记录文字才会发给你配置的 AI；照片不会发送。" draw_text.color: secondary draw_text.text_style.font_size: 10}
            }
        }
    }
}
